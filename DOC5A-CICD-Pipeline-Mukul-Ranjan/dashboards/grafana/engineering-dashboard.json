{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource used by the NovaPay observability dashboards.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Availability SLI",
      "type": "stat",
      "gridPos": {
        "h": 0,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * (1 - sum(rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\",status=~\"5..\"}[5m])) / sum(rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Current service availability. Target SLO: 99.9%."
    },
    {
      "id": 2,
      "title": "HTTP 5xx Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * sum(rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\",status=~\"5..\"}[5m])) / sum(rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Current server-error rate used by rollback alerting."
    },
    {
      "id": 3,
      "title": "p99 Latency",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(novapay_http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "p99 request latency. Assessment scenario also identifies 300ms as a performance trigger."
    },
    {
      "id": 4,
      "title": "Payment Success",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * sum(rate(novapay_payment_transactions_total{environment=~\"$environment\",service=~\"$service\",status=\"success\"}[5m])) / sum(rate(novapay_payment_transactions_total{environment=~\"$environment\",service=~\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{environment}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Payment transaction success rate."
    },
    {
      "id": 5,
      "title": "Traffic / RPS",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (service) (rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Real-time request rate / traffic."
    },
    {
      "id": 6,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * sum by (service) (rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\",status=~\"5..\"}[5m])) / sum by (service) (rate(novapay_http_requests_total{environment=~\"$environment\",service=~\"$service\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "HTTP error rate over time."
    },
    {
      "id": 7,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(novapay_http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\"}[5m])))",
          "refId": "A",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(novapay_http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\"}[5m])))",
          "refId": "B",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(novapay_http_request_duration_seconds_bucket{environment=~\"$environment\",service=~\"$service\"}[5m])))",
          "refId": "C",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "description": "Latency percentiles for production health analysis."
    },
    {
      "id": 8,
      "title": "CPU / Memory Saturation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * avg by (service) (rate(container_cpu_usage_seconds_total{environment=~\"$environment\",container!=\"POD\",container!=\"\"}[5m]))",
          "refId": "A",
          "legendFormat": "CPU {{service}}",
          "range": true,
          "instant": false
        },
        {
          "expr": "100 * avg by (service) (container_memory_working_set_bytes{environment=~\"$environment\",container!=\"POD\",container!=\"\"}) / avg by (service) (container_spec_memory_limit_bytes{environment=~\"$environment\",container!=\"POD\",container!=\"\"})",
          "refId": "B",
          "legendFormat": "Memory {{service}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Runtime saturation. Category B includes CPU >90% and memory >85% for 5m."
    },
    {
      "id": 9,
      "title": "DB Pool Utilization",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "100 * novapay_db_pool_in_use{environment=~\"$environment\"} / novapay_db_pool_max{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Database connection pool utilization."
    },
    {
      "id": 10,
      "title": "Redis / RabbitMQ Queue Depth",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "novapay_redis_queue_depth{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "Redis",
          "range": true,
          "instant": false
        },
        {
          "expr": "novapay_rabbitmq_queue_depth{environment=~\"$environment\"}",
          "refId": "B",
          "legendFormat": "RabbitMQ",
          "range": true,
          "instant": false
        }
      ],
      "description": "Dependency saturation and queue depth."
    },
    {
      "id": 11,
      "title": "Pod Restarts / Health Failures",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum by (service) (rate(kube_pod_container_status_restarts_total{namespace=\"novapay\",container!=\"POD\"}[5m]))",
          "refId": "A",
          "legendFormat": "Restarts {{service}}",
          "range": true,
          "instant": false
        },
        {
          "expr": "sum by (service) (rate(novapay_health_check_failures_total{environment=~\"$environment\"}[5m]))",
          "refId": "B",
          "legendFormat": "Health failures {{service}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Kubernetes restarts and application health failures."
    },
    {
      "id": 12,
      "title": "Deployment / Rollback Events",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum(rate(novapay_deployment_total{environment=~\"$environment\"}[15m]))",
          "refId": "A",
          "legendFormat": "Deployments",
          "range": true,
          "instant": false
        },
        {
          "expr": "sum(rate(novapay_rollback_total{environment=~\"$environment\"}[15m]))",
          "refId": "B",
          "legendFormat": "Rollbacks",
          "range": true,
          "instant": false
        }
      ],
      "description": "Deployment and rollback activity for deployment-aware correlation."
    },
    {
      "id": 13,
      "title": "SLO Error-Budget Burn Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "(sum(rate(novapay_http_requests_total{environment=~\"$environment\",status=~\"5..\"}[10m])) / sum(rate(novapay_http_requests_total{environment=~\"$environment\"}[10m]))) / 0.001",
          "refId": "A",
          "legendFormat": "Burn rate",
          "range": true,
          "instant": false
        }
      ],
      "description": "Simplified 10-minute burn-rate view. 99.9% SLO allows 0.1% error rate; >10x is an escalation condition in the rollback specification."
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "novapay",
    "observability",
    "engineering",
    "real-time"
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(novapay_http_requests_total, environment)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(novapay_http_requests_total{environment=~\"$environment\"}, service)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "NovaPay Engineering \u2014 Real-Time Operations",
  "uid": "novapay-engineering",
  "version": 1,
  "description": "Day 10 Deliverable 8 engineering dashboard. Audience: SRE, on-call engineer, Tech Lead and Incident Commander. Designed around traffic, errors, latency, saturation, payment health, SLO burn and deployment/rollback correlation.",
  "weekStart": ""
}