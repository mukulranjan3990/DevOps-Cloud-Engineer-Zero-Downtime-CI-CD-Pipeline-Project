{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapay.example/schemas/audit-trail-schema.json",
  "title": "NovaPay CI/CD Audit Trail Event",
  "description": "Structured, traceable and tamper-evident audit event for the NovaPay zero-downtime CI/CD pipeline and compliance gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_id",
    "timestamp",
    "pipeline",
    "actor",
    "action",
    "artifact",
    "gate",
    "decision",
    "regulatory_mapping",
    "evidence",
    "integrity"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "pipeline_started",
        "pipeline_completed",
        "compliance_gate_decision",
        "deployment_approved",
        "deployment_blocked",
        "exception_requested",
        "exception_approved",
        "exception_rejected",
        "exception_expired",
        "rollback",
        "remediation"
      ]
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "repository",
        "commit_sha",
        "branch"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string"
        },
        "workflow_run_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "automation",
            "user",
            "service_account"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string"
        },
        "authentication_method": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "STARTED",
            "PASS",
            "FAIL",
            "BLOCKED",
            "APPROVED",
            "REJECTED",
            "EXPIRED"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image_digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "image_repository": {
          "type": "string"
        },
        "sbom_reference": {
          "type": "string"
        },
        "sbom_format": {
          "type": "string",
          "enum": [
            "CycloneDX",
            "SPDX",
            "other"
          ]
        },
        "signature_reference": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "gate_id",
        "name",
        "status"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^GATE-[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": true
        },
        "observed": {
          "type": "object",
          "additionalProperties": true
        },
        "failure_reason": {
          "type": "string"
        },
        "remediation_ticket": {
          "type": "string"
        }
      }
    },
    "regulatory_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rbi",
        "pci_dss"
      ],
      "properties": {
        "rbi": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "pci_dss": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "decided_by",
        "reason"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCK",
            "ALLOW",
            "REJECT"
          ]
        },
        "decided_by": {
          "type": "string",
          "enum": [
            "automation",
            "authorized_user",
            "dual_approval"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approval_reference": {
          "type": "string"
        },
        "approval_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "exception": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "exception_id",
        "status",
        "owner",
        "approver",
        "justification",
        "compensating_control",
        "requested_at",
        "expires_at"
      ],
      "properties": {
        "exception_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "REQUESTED",
            "ACTIVE",
            "REJECTED",
            "EXPIRED",
            "CLOSED"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "risk_classification": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "compensating_control": {
          "type": "string",
          "minLength": 1
        },
        "remediation_plan": {
          "type": "string"
        },
        "remediation_ticket": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "type",
          "reference"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "scan_report",
              "test_report",
              "sbom",
              "approval",
              "change_ticket",
              "commit",
              "deployment_record",
              "exception_record",
              "policy_result",
              "log"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_hash",
        "hash_algorithm",
        "immutable_store"
      ],
      "properties": {
        "event_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "previous_event_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        },
        "hash_algorithm": {
          "type": "string",
          "const": "SHA-256"
        },
        "immutable_store": {
          "type": "boolean",
          "const": true
        },
        "retention_class": {
          "type": "string",
          "enum": [
            "REGULATORY",
            "SECURITY",
            "OPERATIONAL"
          ]
        }
      }
    }
  }
}
