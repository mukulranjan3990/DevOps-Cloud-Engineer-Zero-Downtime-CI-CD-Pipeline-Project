pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(false)

        // Prevent Jenkins from keeping an unnecessarily large build history.
        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    environment {
        JAVA_VERSION = '21'
        IMAGE_NAME   = 'novapay-payment'

        // Replace these through Jenkins credentials/environment configuration.
        REGISTRY     = 'host.docker.internal:5000'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        IMAGE        = "${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

        HELM_CHART   = 'pipeline/helm/novapay'
        VALUES_FILE  = 'pipeline/helm/novapay/values.yaml'
        OPA_POLICIES = 'pipeline/policies'
    }

    stages {

        // ================================================================
        // STAGE 1 — SOURCE VALIDATION
        // ================================================================
        stage('1. Source Validation') {
            steps {
                echo 'Starting source validation...'

                sh '''
                    set -e

                    echo "=== Git Status ==="
                    git status --short

                    echo "=== Repository Validation ==="

                    test -f pipeline/.github/workflows/novapay-ci.yml
                    test -d pipeline/helm/novapay
                    test -d pipeline/terraform
                    test -d pipeline/policies

                    echo "Required project structure exists."
                '''

                sh '''
                    set -e

                    echo "=== YAML Validation ==="

                    yamllint pipeline/.github/workflows/novapay-ci.yml

                    echo "YAML validation passed."
                '''
            }
        }


        // ================================================================
        // STAGE 2 — BUILD & UNIT TEST
        // ================================================================
        stage('2. Build & Unit Test') {
            steps {
                echo 'Building NovaPay application and running unit tests...'

                sh '''
                    set -e

                    echo "Java version:"
                    java -version

                    echo "JAVA_VERSION=${JAVA_VERSION}"

                    # Application build/test command.
                    # Replace with the project's actual Maven/Gradle command
                    # when application source is present.
                    if [ -f pom.xml ]; then
                        ./mvnw clean test package -DskipTests=false
                    elif [ -f mvnw ]; then
                        ./mvnw clean test package -DskipTests=false
                    elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then
                        ./gradlew clean test build
                    else
                        echo "Application source/build files are not present."
                        echo "Pipeline infrastructure validation continues."
                    fi
                '''
            }
        }


        // ================================================================
        // STAGE 3 — SAST
        // ================================================================
        stage('3. SAST') {
            steps {
                echo 'Running Static Application Security Testing...'

                sh '''
                    set -e

                    echo "=== SonarQube SAST ==="

                    if command -v sonar-scanner >/dev/null 2>&1; then
                        sonar-scanner
                    else
                        echo "SonarScanner is not installed on this Jenkins agent."
                        echo "Configure SonarQube/SonarScanner in Jenkins for execution."
                    fi
                '''
            }
        }


        // ================================================================
        // STAGE 4 — DEPENDENCY & CONTAINER SCANNING
        // ================================================================
        stage('4. Dependency & Container Scanning') {
            steps {
                echo 'Running dependency and container security checks...'

                sh '''
                    set -e

                    echo "=== Trivy ==="

                    if command -v trivy >/dev/null 2>&1; then

                        echo "Scanning filesystem..."
                        trivy fs \
                            --severity HIGH,CRITICAL \
                            --exit-code 1 \
                            .

                    else
                        echo "Trivy is not installed on this Jenkins agent."
                        echo "Configure Trivy before enabling enforcement."
                    fi
                '''

                sh '''
                    set -e

                    echo "=== Container Image ==="

                    if command -v docker >/dev/null 2>&1; then

                        echo "Building validation image:"
                        echo "${IMAGE}"

                        docker build \
                            -t "${IMAGE}" \
                            .

                    else
                        echo "Docker is not available on this Jenkins agent."
                    fi
                '''
            }
        }


        // ================================================================
        // STAGE 5 — INTEGRATION & CONTRACT TESTING
        // ================================================================
        stage('5. Integration & Contract Testing') {
            steps {
                echo 'Running integration and contract tests...'

                sh '''
                    set -e

                    echo "=== Integration Tests ==="

                    if [ -f pom.xml ]; then
                        ./mvnw verify
                    elif [ -f mvnw ]; then
                        ./mvnw verify
                    elif [ -f build.gradle ] || [ -f build.gradle.kts ]; then
                        ./gradlew integrationTest
                    else
                        echo "Application integration-test project is not present."
                        echo "Integration/contract execution requires the application test suite."
                    fi
                '''
            }
        }


        // ================================================================
        // STAGE 6 — DAST
        // ================================================================
        stage('6. DAST') {
            steps {
                echo 'Running Dynamic Application Security Testing...'

                sh '''
                    set -e

                    echo "=== OWASP ZAP ==="

                    if command -v zap-baseline.py >/dev/null 2>&1; then

                        zap-baseline.py \
                            -t "${DAST_TARGET:-http://localhost:8080}" \
                            -r zap-report.html

                    else
                        echo "OWASP ZAP is not installed on this Jenkins agent."
                        echo "Configure ZAP and DAST_TARGET before enforcement."
                    fi
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'zap-report.html',
                        allowEmptyArchive: true
                    )
                }
            }
        }


        // ================================================================
        // STAGE 7 — POLICY & COMPLIANCE GATES
        // ================================================================
        stage('7. Policy & Compliance Gates') {
            steps {
                echo 'Executing OPA policy and compliance gates...'

                sh '''
                    set -e

                    echo "=== OPA Validation ==="

                    opa check "${OPA_POLICIES}"

                    echo "OPA policy validation passed."
                '''

                sh '''
                    set -e

                    echo "=== OPA Policy Module Validation ==="

                    opa test \
                        "${OPA_POLICIES}/encryption.rego" \
                        "${OPA_POLICIES}/image-signing.rego" \
                        "${OPA_POLICIES}/kubernetes-security.rego"

                    echo "OPA policy module validation passed."
                '''

                sh '''
                    set -e

                    echo "=== Helm Compliance Validation ==="

                    helm lint "${HELM_CHART}"

                    helm template novapay "${HELM_CHART}" \
                        -f "${VALUES_FILE}" \
                        > rendered.yaml

                    echo "Helm policy/configuration validation passed."
                '''

                sh '''
                    set -e

                    echo "=== Terraform Formatting Validation ==="

                    terraform fmt \
                        -check \
                        -recursive \
                        pipeline/terraform

                    echo "Terraform formatting validation passed."
                '''
            }
        }


        // ================================================================
        // STAGE 8 — DEPLOYMENT & VERIFICATION
        // ================================================================
        stage('8. Deployment & Verification') {
            steps {
                echo 'Starting deployment verification...'

                sh '''
                    set -e

                    echo "=== Kubernetes Server-Side Validation ==="

                    kubectl apply \
                        --dry-run=server \
                        -f rendered.yaml

                    echo "Kubernetes manifest validation passed."
                '''

                echo '''
                Deployment strategy:

                DEV
                  ↓
                STAGING
                  ↓
                PRE-PROD
                  ↓
                PRODUCTION

                Production deployment uses the approved immutable artifact
                with progressive canary verification and rollback controls.
                '''
            }
        }
    }


    // ====================================================================
    // POST PIPELINE
    // ====================================================================
    post {

        success {
            echo '''
            ================================================================
            NOVAPAY CI/CD PIPELINE PASSED
            ================================================================
            All configured pipeline stages completed successfully.
            '''
        }

        failure {
            echo '''
            ================================================================
            NOVAPAY CI/CD PIPELINE FAILED
            ================================================================
            Deployment must not proceed until the failed gate is resolved.
            '''
        }

        unstable {
            echo '''
            ================================================================
            NOVAPAY PIPELINE UNSTABLE
            ================================================================
            Review warnings and security/compliance findings.
            '''
        }

        always {
            archiveArtifacts(
                artifacts: 'rendered.yaml',
                allowEmptyArchive: true
            )

            echo "Build: ${BUILD_NUMBER}"
            echo "Job: ${JOB_NAME}"
            echo "Git Commit: ${GIT_COMMIT ?: 'N/A'}"
        }
    }
}